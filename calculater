A = float(input("Enter first number: "))
B = float(input("Enter second number: "))
operator = input("Enter operator (+, -, *, /):")

if operator == "+":
    result = A + B
    print("Result:", result)

elif operator == "-":
    result = A- B
    print("Result:", result)

elif operator == "*":
    result = A* B
    print("Result:", result)

elif operator == "/":
    if B!= 0:
        result = A / B
        print("Result:", result)

    else:
        print("Error: Cannot divide by zero!")

else:
    print("Invalid operator!")